{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "V2RayEZ",
  "version": "2.0.0",
  "identifier": "app.v2rayez.universal",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "node scripts/dev-server.mjs",
    "beforeBuildCommand": "node scripts/build-frontend.mjs && node scripts/prepare-sidecar.mjs"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "V2RayEZ",
        "width": 430,
        "height": 860,
        "minWidth": 360,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "deb",
      "rpm",
      "appimage"
    ],
    "publisher": "V2RayEZ",
    "category": "Utility",
    "shortDescription": "V2RayEZ Universal desktop client",
    "longDescription": "Connect through V2RayEZ Universal with preserved V2RayEZ GUI, Aether/MSN core adapter, TUN routing, DNS protection, recovery, license gating, and no-code AI Provider Gateway.",
    "externalBin": [
      "binaries/aether",
      "binaries/sing-box"
    ],
    "resources": [
      "../third-party/sing-box-LICENSE.txt"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
