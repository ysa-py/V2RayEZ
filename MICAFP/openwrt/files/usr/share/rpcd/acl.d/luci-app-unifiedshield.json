{
  "luci-app-unifiedshield": {
    "description": "Grant LuCI access to the Vor Universal / UnifiedShield OpenWrt service",
    "read": {
      "uci": ["unifiedshield"],
      "ubus": {
        "service": ["list"],
        "network.interface": ["status"],
        "file": ["read"]
      }
    },
    "write": {
      "uci": ["unifiedshield"],
      "ubus": {
        "service": ["set", "delete", "signal"]
      }
    }
  }
}
