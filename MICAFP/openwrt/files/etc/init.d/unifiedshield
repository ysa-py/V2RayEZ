#!/bin/sh /etc/rc.common
# Vor Universal / UnifiedShield OpenWrt procd service

START=95
STOP=10
USE_PROCD=1

SERVICE_BIN="/usr/bin/unifiedshield"
LICENSE_GATE="/usr/libexec/unifiedshield/license-gate.sh"
LICENSE_WATCHDOG="/usr/libexec/unifiedshield/license-watchdog.sh"

uci_get() {
    uci -q get "unifiedshield.default.$1" 2>/dev/null || true
}

start_service() {
    [ "$(uci_get enabled)" = "1" ] || return 0

    if ! "$LICENSE_GATE" enforce; then
        logger -t unifiedshield "service start blocked by license gate"
        return 1
    fi

    procd_open_instance unifiedshield
    procd_set_param command "$SERVICE_BIN" --config unifiedshield --section default
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file /etc/config/unifiedshield
    procd_close_instance

    procd_open_instance license_watchdog
    procd_set_param command "$LICENSE_WATCHDOG"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file /etc/config/unifiedshield
    procd_close_instance
}

reload_service() {
    if ! "$LICENSE_GATE" validate; then
        logger -t unifiedshield "reload blocked by license gate"
        stop
        return 1
    fi
    procd_send_signal unifiedshield unifiedshield HUP
}

stop_service() {
    procd_kill unifiedshield license_watchdog 2>/dev/null || true
    procd_kill unifiedshield unifiedshield 2>/dev/null || true
}

service_triggers() {
    procd_add_reload_trigger unifiedshield
}
